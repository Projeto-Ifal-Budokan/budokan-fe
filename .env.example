NEXT_PUBLIC_API_URL=http://localhost:8001
# Login com o Google no formulario de depoimento.
# Credencial OAuth do tipo 'Web client' no Google Cloud Console, com esta URL
# autorizada em 'Authorized JavaScript origins': https://budokanryu.com.br
# So o ID e necessario: o fluxo usa o ID token do Google Identity Services, e a
# verificacao acontece no servidor do Next. O client secret nao e usado e nao
# deve ser colocado aqui.
# Sem esta chave o botao aparece como indisponivel e o envio e recusado.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=000000000000-abc123.apps.googleusercontent.com
